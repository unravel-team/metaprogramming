{
  "name": "typescript-scaffold",
  "version": "0.1.0",
  "description": "Standalone Next.js application and TypeScript library scaffold",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && next build && tsc -p tsconfig.lib.json && node scripts/stage-library.mjs",
    "dev": "next dev",
    "start": "next start",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.default.config.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@hegeldev/hegel": "0.4.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "dbmate": "2.35.1",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
